{
  "expo": {
    "name": "QwenPaw",
    "slug": "qwenpaw-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "qwenpaw",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "io.agentscope.qwenpaw.mobile",
      "supportsTablet": true,
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.agentscope.qwenpaw.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QwenPaw to scan a secure pairing QR code.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow QwenPaw to protect your connection credentials."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow QwenPaw to view media you choose.",
          "savePhotosPermission": "Allow QwenPaw to save chat images to your photo library."
        }
      ],
      "expo-sharing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
